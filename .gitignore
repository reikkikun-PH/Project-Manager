# Hosted project folders live only on the host PC, never in git
Project List/
# Extra instances keep their own state here (see README: multi-instance)
instances/

# Runtime state - changes every time you add a project or create an account.
# Kept out of git so `sh termux.sh update` can never clobber your real data.
# A fresh clone starts empty (or copy projects.example.json to get the samples).
projects.json

# Secrets - never commit real logins or lock passwords
credentials.json
project_auth.json
**/credentials.json
# Approval e-mail settings (contains the Resend API key) - local only
notify.json
notify.log

# Runtime logs / tunnel state
server-out.log
server-err.log
tunnel.log
tunnel-*.log
tunnel-url.txt
runner-out.log
runner-err.log
*.log
logs8101.json

# Cloudflared binaries (~90MB) - download per README.md, not stored in git
cloudflared
cloudflared.exe

# Large models + private data (re-download / re-add locally)
*.onnx
Project List/verifid/employee data/
Project List/verifid/logs/

# Python
__pycache__/
*.pyc
venv/